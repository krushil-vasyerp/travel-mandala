# PostgreSQL connection string from Neon (or wherever you host it)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string — used to sign admin login tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# The PIN admins type in to unlock editing. Change this.
ADMIN_PIN=1234

# Your live Netlify URL (no trailing slash) — required for CORS + sockets
FRONTEND_URL=https://travel-mandala.netlify.app

# Render sets this automatically; only needed for local dev
PORT=3000
